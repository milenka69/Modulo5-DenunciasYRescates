PORT=4000
FRONTEND_URL=http://localhost:5173
NUCLEO_URL=https://nucleo-tr.onrender.com
# Opcional. Configurar cuando se implemente la persistencia de denuncias.
MONGODB_URI=
# En producción: TLS en un proxy de confianza; frontend y /api bajo el mismo origen.
NODE_ENV=development
# Activar solo si existe exactamente un proxy de confianza que sobrescribe X-Forwarded-Proto.
TRUST_PROXY=0
